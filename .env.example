VITE_ENTRA_CLIENT_ID=da6237e3-41c7-4aeb-8581-f3233fba55ec
VITE_ENTRA_TENANT_ID=d2f14563-310c-4cdc-9b42-8d93451f4c33
VITE_ENTRA_REDIRECT_URI=https://localhost:5173
VITE_DATAVERSE_URL=https://yourorg.crm.dynamics.com
VITE_DATAVERSE_SCOPE=https://yourorg.crm.dynamics.com/user_impersonation
# Base URL of the deployed Vercel app — needed as an absolute URL (not a
# relative path) because the native Capacitor app bundles dist/ and loads it
# from a local capacitor:// origin, not from Vercel, so relative /api/* calls
# would otherwise resolve against that fake local origin and fail silently.
VITE_API_BASE_URL=https://your-app.vercel.app
# Azure Maps subscription key, exposed to the client for the Web SDK (map
# tile/route rendering) — this is the normal, expected way map SDKs work,
# unlike the AI/LLM keys used server-only elsewhere. Consider monitoring
# usage in the Azure Portal since a static client-side key can be scraped.
VITE_AZURE_MAPS_KEY=your-azure-maps-key
